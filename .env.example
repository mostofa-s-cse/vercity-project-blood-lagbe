# Copy this file to .env.local and fill in the values. See docs/SETUP-SUPABASE.md.
# The app runs without any of these (as a demo with sample data); each group switches on a feature.

# --- Sign in with Google (Supabase Auth) ---------------------------------------------------
# Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# The publishable key (older projects call it the "anon" key). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-KEY"

# --- Database (Prisma + Supabase Postgres) -------------------------------------------------
# Supabase dashboard > Connect > ORMs > Prisma. Replace [YOUR-PASSWORD] with the database password.
# App traffic goes through the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Migrations use a direct or session connection (port 5432).
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
