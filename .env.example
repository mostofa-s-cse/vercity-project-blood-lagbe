# Copy this file to .env.local and fill in the values. See docs/SETUP-SUPABASE.md.
# The app runs without any of these (as a demo with sample data); each group switches on a feature.
# vercel -> mostofa.mm48@gamil.com-> supabase -> mostofa.mm48@gmail.com

# --- Sign in with Google (Supabase Auth) ---------------------------------------------------
# Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# The publishable key (older projects call it the "anon" key). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-KEY"

# --- Roles: hospital and admin accounts ----------------------------------------------------
# SECRET. Server only: never prefix it with NEXT_PUBLIC_. Supabase dashboard > Project Settings > API > service_role (secret) key.
# The admin panel uses it to give people roles by writing their login data. It bypasses ALL security:
# keep it out of git and out of the browser. Needs DATABASE_URL as well.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
# Optional, comma separated. These emails become admins the first time they sign in, so you never have to touch SQL.
ADMIN_EMAILS="you@example.com"

# --- Admin area ----------------------------------------------------------------------------
# The Admin Panel and Ops Command are only for admin accounts (docs/SETUP-SUPABASE.md, "Choose who is an admin").
# Without Supabase nobody can prove they are an admin, so they stay CLOSED. For a local demo you can open them:
# NEXT_PUBLIC_ADMIN_OPEN="true"

# The sign-in page can list one-click demo accounts (donor, hospital, admin, password shown on screen).
# Leave it OFF on a public deployment: anyone could sign in as the hospital or the admin and change live data.
# Turn it on only for a closed demo, and change those passwords afterwards.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"

# --- Database (Prisma + Supabase Postgres) -------------------------------------------------
# Supabase dashboard > Connect > ORMs > Prisma. Replace [YOUR-PASSWORD] with the database password.
# App traffic goes through the transaction pooler (port 6543). Do NOT use port 5432 here on Vercel: the session
# pooler allows only ~15 clients in total, every warm serverless instance holds its own, and once they run out
# every database read fails with 500 "load_failed" until instances go cold.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Migrations use a direct or session connection (port 5432).
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"
